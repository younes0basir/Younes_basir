# Copy to `.env` for local development:
#   cp .env.example .env
#
# For Vercel: Project → Settings → Environment Variables
# Add every `VITE_*` variable below to Production (and Preview if needed).
# Do not add APPWRITE_API_KEY to Vercel — it is only for local setup scripts.

# -----------------------------------------------------------------------------
# Appwrite (client — required for CMS, gallery, and /admin)
# Console → your project → Settings
# Region examples: fra, nyc, syd
# -----------------------------------------------------------------------------
VITE_APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=<PROJECT_ID>

# Optional overrides (defaults match npm run appwrite:setup)
VITE_APPWRITE_DATABASE_ID=xxxxxxxxxx
VITE_APPWRITE_PROJECTS_COLLECTION_ID=projects
VITE_APPWRITE_GALLERY_COLLECTION_ID=gallery
VITE_APPWRITE_GALLERY_BUCKET_ID=gallery

# -----------------------------------------------------------------------------
# Cloudinary (client — required for gallery/project images and admin uploads)
# Console → Settings → Upload → unsigned preset
# -----------------------------------------------------------------------------
VITE_CLOUDINARY_CLOUD_NAME=<CLOUD_NAME>
VITE_CLOUDINARY_UPLOAD_PRESET=<UNSIGNED_UPLOAD_PRESET>

# -----------------------------------------------------------------------------
# Local scripts only (never expose in the browser or on Vercel)
# Used by: npm run appwrite:setup
# Console → your project → API keys → create key with databases + storage scopes
# -----------------------------------------------------------------------------
APPWRITE_API_KEY=<API_KEY>
